# 复制成 .env 后按需填写：cp .env.example .env
APP_ENV=dev
DEBUG=true
MOCK_MODE=true

# 外部服务凭据（第一阶段留空，MOCK_MODE=true 时不会被读取）
# 第 4 阶段：填了 OPENAI_API_KEY 才会走 LLM，留空则自动降级为规则解析
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=

# 可选：模型与网关（默认 gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# 主流程跑通后再接数据库，届时启用
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/travel_agent
